# Discord Selfbot Voice Joiner - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve tokenlerinizi girin.

# Discord token'ları (virgülle ayırın, boşluk bırakmayın)
TOKENS=TOKEN_1,TOKEN_2,TOKEN_3

# Varsayılan sunucu ID'si (tüm tokenler için geçerli, per-token config ile override edilebilir)
DEFAULT_GUILD_ID=000000000000000000

# Varsayılan ses kanalı ID'si (tüm tokenler için geçerli, per-token config ile override edilebilir)
DEFAULT_CHANNEL_ID=000000000000000000
